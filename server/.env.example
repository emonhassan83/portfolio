NODE_ENV=development
PORT=5000
DATABASE_URL=mongodb://localhost:27017/portfolio

# Comma-separated allowlist of browser origins. The FIRST entry receives the
# revalidation call after dashboard edits.
CLIENT_URL=http://localhost:3000

BCRYPT_SALT_ROUNDS=12

# Use long random strings, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# Signs the 5-minute login challenge. Falls back to JWT_ACCESS_SECRET.
JWT_CHALLENGE_SECRET=change-me
JWT_ACCESS_EXPIRE_IN=15m
JWT_REFRESH_EXPIRE_IN=7d

# Encrypts authenticator (TOTP) secrets and keys backup-code hashes. Falls back to JWT_ACCESS_SECRET.
# Changing it invalidates every enrolled authenticator and backup code.
TOTP_ENCRYPTION_KEY=change-me
# Optional: account name shown in the authenticator app.
TOTP_ISSUER=Portfolio Dashboard

# Must equal REVALIDATE_SECRET in client/.env
REVALIDATE_SECRET=change-me

RESET_PASS_LINK=http://localhost:3000/reset-password
EMAIL=your-email@gmail.com
APP_PASS=your-google-app-password
